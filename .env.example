# ---- PayPal (sandbox only; never use live credentials) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ---- AI: any OpenAI-compatible gateway ----
# Hosted demo uses ASU Research Computing's LLM API (key from the Voyager portal).
# Keep the /v1 suffix on the base URL.
LLM_BASE_URL=https://openai.rc.asu.edu/v1
LLM_API_KEY=
AGENT_MODEL=          # pick in Phase 0 from GET /v1/models (needs supports_function_calling)
CHECKER_MODEL=        # fast model with reliable JSON output
DEMO_REPLAY=false     # true = serve recorded agent runs if the LLM is slow/unavailable

# ---- Audio / voice (ElevenLabs) — server-side only; generated clips are committed ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_SCOUT=
ELEVENLABS_VOICE_PENNY=
ELEVENLABS_AGENT_ID=

# ---- App ----
# SQLite locally ("file:./dev.db"); Postgres on the hosted demo ("postgres://...").
# lib/db picks the driver from the URL. See docs/DECISIONS.md for the schema
# provider swap when deploying to Postgres.
DATABASE_URL=file:./dev.db
AGENT_API_KEY=change-me
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true
