# ---- PayPal (sandbox only; never use live credentials) ----
# Developer Dashboard → Apps & Credentials → Sandbox → your app → App Feature Options:
#   tick "Accept payments", expand Advanced options, tick "Vault" (needed to save a wallet without a purchase).
# PAYPAL_MODE=mock runs the whole flow locally with labelled fake payment ids; the hosted demo uses sandbox.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ---- AI: any OpenAI-compatible gateway ----
# Hosted demo uses ASU Research Computing's LLM API (key from the Voyager portal).
# Keep the /v1 suffix on the base URL.
LLM_BASE_URL=https://openai.rc.asu.edu/v1
LLM_API_KEY=
AGENT_MODEL=gpt-oss-120b            # measured 2026-11-02, see docs/DECISIONS.md
CHECKER_MODEL=granite41-30b   # measured on the real prompt: correct in 3–5 s (see docs/DECISIONS.md)
DEMO_REPLAY=false     # true = serve recorded agent runs if the LLM is slow/unavailable

# ---- Audio / voice (ElevenLabs) — server-side only; generated clips are committed ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_SCOUT=
ELEVENLABS_VOICE_PENNY=
ELEVENLABS_AGENT_ID=

# ---- App ----
# Neon Postgres. `neon checkout dev` fills these in for local work (pooled URL for
# the app, direct URL for schema pushes). The hosted demo uses the `main` branch.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AGENT_API_KEY=change-me
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true
